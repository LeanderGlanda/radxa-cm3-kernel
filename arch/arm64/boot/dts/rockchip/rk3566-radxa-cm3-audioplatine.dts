	gpio-line-names =
		/* GPIO3_A0-A3 */
		"", "", "", "",
		/* GPIO3_A4-A7 */
		"", "", "", "",

		/* GPIO3_B0-B3 */
		"", "", "", "",
		/* GPIO3_B4-B7 */
		"", "", "", "",

		/* GPIO3_C0-C3 */
		"", "", "", "",
		/* GPIO3_C4-C7 */
		"", "", "PIN_22", "PIN_12",

		/* GPIO3_D0-D3 */
		"PIN_35", "PIN_40", "PIN_38", "PIN_18",
		/* GPIO3_D4-D7 */
